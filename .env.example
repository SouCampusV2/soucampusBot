# ---- Required ----
DISCORD_TOKEN=
CLIENT_ID=

# GUILD_ID: your Discord server ID. If set, slash commands register instantly to that
# server (best for development). Leave empty in production to register commands GLOBALLY.
GUILD_ID=

DB_PATH=./database/bot.db
LOG_LEVEL=info

# ---- Per-server configuration ----
# The recommended way to configure the bot is the in-Discord /setup command
# (run by a server admin), which stores settings per-server in the database.
# The variables below are OPTIONAL fallbacks used only when a server hasn't set
# the corresponding value via /setup — handy for a single-server deployment.

# Roles (role IDs). Or leave empty and create roles named "Manager" / "Freelancer".
ROLE_MANAGER_ID=
ROLE_FREELANCER_ID=

# Category IDs
CATEGORY_ACTIVE_ORDERS=
CATEGORY_QUOTES=
CATEGORY_ARCHIVED=

# Channel IDs
CHANNEL_TICKET_PANEL=
CHANNEL_REVIEWS=

# Brand color for embeds (hex). Falls back to Discord blurple #5865F2.
BRAND_COLOR=
