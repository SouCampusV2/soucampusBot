DISCORD_TOKEN=
CLIENT_ID=
# GUILD_ID = ID вашего Discord-сервера (гильдии). Включите «Режим разработчика» в Discord → правый клик по иконке сервера → «Копировать ID сервера». Нужен для регистрации слеш-команд и т.п.
GUILD_ID=
DB_PATH=./database/bot.db
LOG_LEVEL=info

# Роль менеджера: укажите ID роли ИЛИ создайте роль с именем "Manager".
ROLE_MANAGER_ID=

# Роль фрилансера: укажите ID роли ИЛИ создайте роль с именем "Freelancer" (для каналов QUOTES).
ROLE_FREELANCER_ID=

# Category IDs (set after first server setup)
CATEGORY_ACTIVE_ORDERS=
CATEGORY_QUOTES=
CATEGORY_ARCHIVED=

# Channel IDs
CHANNEL_TICKET_PANEL=
CHANNEL_REVIEWS=
